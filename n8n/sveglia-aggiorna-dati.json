        "jsonBody": "{ \"ref\": \"main\" }",
        "options": {
          "response": { "response": { "fullResponse": true } }
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Fai partire GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 60000,
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "GitHub freellmrank (Actions)" }
      }
    },
    {
      "parameters": { "amount": 5, "unit": "minutes" },
